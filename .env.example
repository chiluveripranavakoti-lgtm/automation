# ==============================================================================
# Daily AI Morning Briefing - Environment Configuration
# ==============================================================================

# Recipient Email Address where the briefing will be delivered
RECIPIENT_EMAIL=your-email@example.com

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini Model Name (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Maximum hours to look back for RSS articles (default: 48)
LOOKBACK_HOURS=48

# Maximum candidate articles to aggregate for LLM processing (default: 50)
MAX_CANDIDATES=50

# Number of top stories to select in final briefing (default: 5)
TOP_STORIES=5

# Timezone for execution and date formatting
TIMEZONE=Asia/Kolkata

# Scheduled delivery time (24-hour format HH:MM)
SCHEDULE_TIME=08:00

# Gmail API OAuth Credentials (path to credentials.json downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail API OAuth Token storage file (automatically generated after first login)
GMAIL_TOKEN_FILE=token.json

# SQLite database path for persistent deduplication and run tracking
DATABASE_PATH=data/briefing.db

# Optional custom RSS feeds JSON file path (leave blank to use built-in feeds)
CUSTOM_FEEDS_FILE=
